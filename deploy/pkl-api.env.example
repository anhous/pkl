# Template .env PRODUKSI untuk apps/api/.env di VPS.
# Salin isi ini ke apps/api/.env lalu ganti nilai <...>. JANGAN commit file .env.
PORT=4000
NODE_ENV=production
DATABASE_URL="mysql://pkl:<password-kuat>@localhost:3306/pkl_db"
JWT_SECRET="<isi-dengan-openssl-rand-hex-32>"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true
CORS_ORIGIN=https://pkl.sekolah.id
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# Cloudinary (opsional; kosongkan = lokal)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SEED_ADMIN_EMAIL=superadmin@sekolah.id
SEED_ADMIN_PASSWORD=<ganti-setelah-login-pertama>
# Lupa password: APP_URL = frontend publik untuk link reset.
APP_URL=https://pkl.sekolah.id
RESET_TOKEN_EXPIRES_MINUTES=60
# SMTP (kosongkan = email dilewati, link reset dicatat di log server via `pm2 logs`).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SDMS (isi setelah daftarkan app di Application Hub)
SDMS_BASE_URL=http://sdms.smkn1kras.sch.id
SDMS_USERNAME=
SDMS_PASSWORD=
SDMS_API_KEY=
SDMS_WEBHOOK_SECRET=
SDMS_SYNC_ENABLED=false
SDMS_PULL_CRON=0 2 * * *
SDMS_PUSH_CRON=5 * * * *
