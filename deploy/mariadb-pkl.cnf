# Tuning MariaDB untuk Jurnal PKL — Ubuntu 24
# Pasang: sudo cp deploy/mariadb-pkl.cnf /etc/mysql/mariadb.conf.d/60-pkl.cnf
# Lalu: sudo systemctl restart mariadb
# Pilih SALAH SATU blok buffer pool sesuai RAM VPS (uncomment yang dipakai).
#
# Catatan: مشروع ini query-nya ringan (CRUD + pagination). Yang paling
# berpengaruh adalah buffer pool (cache data/index InnoDB) dan max_connections
# yang selaras dengan pool Prisma (default: 2×vCPU+1 per instance API).

[mysqld]

# --- Umum (semua ukuran) ---
max_connections         = 100
connect_timeout         = 10
wait_timeout            = 28800
max_allowed_packet      = 64M
thread_cache_size       = 32
table_open_cache        = 2000

# InnoDB: file-per-table + fsync aman untuk VPS
innodb_file_per_table   = 1
innodb_flush_log_at_trx_commit = 1
innodb_flush_method     = O_DIRECT
innodb_log_file_size    = 256M
innodb_log_buffer_size  = 16M

# Query cache MATI (deprecated & bermasalah di MariaDB 10.2+)
query_cache_type        = 0
query_cache_size        = 0

# Slow log: temukan query >1 detik (lalu OPTIMIZE/TAMBAH index)
slow_query_log          = 1
slow_query_log_file     = /var/log/mysql/mariadb-slow.log
long_query_time         = 1
log_output              = FILE

# --- Buffer pool: pakai ±60% RAM. Pilih SATU: ---
# VPS 2 GB:
innodb_buffer_pool_size = 1G
# VPS 4 GB:  (hapus # di bawah, comment baris 1G)
#innodb_buffer_pool_size = 2560M
# VPS 8 GB:
#innodb_buffer_pool_size = 5G

innodb_buffer_pool_instances = 1
