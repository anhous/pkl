# Salin ke .env
PORT=4000
NODE_ENV=development
DATABASE_URL="mysql://pkl:pkl@localhost:3306/pkl_db"
JWT_SECRET="ganti-min-32-karakter-acak-di-sini"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# Cloudinary (opsional Fase 2, kosongkan jika pakai lokal)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Akun seed superadmin
SEED_ADMIN_EMAIL=superadmin@sekolah.id
SEED_ADMIN_PASSWORD=Superadmin123!
# --- Integrasi SDMS SMKN 1 Kras (http://sdms.smkn1kras.sch.id) ---
# Kredensial akun SDMS yang punya akses master + gateway jurnal.
SDMS_BASE_URL=http://sdms.smkn1kras.sch.id
SDMS_USERNAME=
SDMS_PASSWORD=
# API key AppHub (wajib untuk pull, dikirim sebagai X-API-Key bersama Bearer)
SDMS_API_KEY=
# Secret HMAC webhook — SAMAKAN dengan yang didaftarkan di SDMS Application Hub.
# Webhook URL yang didaftarkan: https://<domain-pkl>/api/webhooks/sdms
SDMS_WEBHOOK_SECRET=
# Scheduler otomatis (butuh server jalan terus). Format cron standar.
SDMS_SYNC_ENABLED=false
SDMS_PULL_CRON=0 2 * * *
SDMS_PUSH_CRON=5 * * * *
